---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Inscription Événement">
  <section class="container py-5 text-center redirection-container">
    <div class="hud-panel redirection-panel py-5">
      <div class="radar-scan"></div>
      <h1 class="section-title">REDIRECTION TACTIQUE</h1>
      <p class="section-subtitle">Chargement de la zone d'inscription...</p>
      
      <p class="info-text">
        Les inscriptions pour tous nos événements et parties dominicales s'effectuent exclusivement via notre serveur Discord officiel.
      </p>

      <div class="countdown-box my-3">
        <span class="countdown-label">Redirection dans</span>
        <span id="countdown" class="countdown-num">3</span>
        <span class="countdown-label">secondes...</span>
      </div>

      <div class="actions">
        <a href="https://discord.gg/uXB4TcP7Yy" class="hud-btn hud-btn-filled">Rejoindre Directement</a>
        <a href="/" class="hud-btn">Annuler</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  let count = 3;
  const countdownEl = document.getElementById('countdown');
  
  const interval = setInterval(() => {
    count--;
    if (countdownEl) {
      countdownEl.textContent = count.toString();
    }
    if (count <= 0) {
      clearInterval(interval);
      window.location.href = "https://discord.gg/uXB4TcP7Yy";
    }
  }, 1000);
</script>

<style>
  .redirection-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
  }

  .redirection-panel {
    max-width: 600px;
    width: 100%;
    padding: 3rem;
    background-color: var(--color-bg-card);
    position: relative;
    overflow: hidden;
  }

  .section-subtitle {
    font-family: var(--font-sub);
    font-size: 1.25rem;
    color: var(--color-primary);
    letter-spacing: 1px;
    margin-bottom: 2rem;
  }

  .info-text {
    font-size: 1.05rem;
    margin-bottom: 2rem;
    color: var(--color-text-muted);
  }

  .countdown-box {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-title);
    font-size: 1.1rem;
    color: var(--color-text-muted);
  }

  .countdown-num {
    font-size: 3rem;
    font-weight: 900;
    color: var(--color-primary);
    text-shadow: 0 0 10px rgba(193, 185, 127, 0.4);
    min-width: 50px;
  }

  .actions {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  /* Effet radar scanline */
  .radar-scan {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
    animation: scan 2s linear infinite;
    pointer-events: none;
    opacity: 0.3;
  }

  @keyframes scan {
    0% {
      top: 0%;
    }
    100% {
      top: 100%;
    }
  }

  @media (max-width: 600px) {
    .actions {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
