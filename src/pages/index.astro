---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import GlassCard from '../components/GlassCard.astro';
import CalendarWidget from '../components/CalendarWidget.astro';
import TarifsSection from '../components/TarifsSection.astro';
import CaubousMap from '../components/CaubousMap.astro';
import LiveRegistrationsWidget from '../components/LiveRegistrationsWidget.astro';
---

<Layout
  title="Club Airsoft ASAP – Nay (64) | Milsim & Parties Dominicales"
  description="Rejoignez l'ASAP, association airsoft à Nay (64) dans les Pyrénées-Atlantiques. Parties dominicales, Milsim immersif et événements scénarisés dans le Béarn."
>

  <!-- ═══════════════ HERO ═══════════════ -->
  <section class="hero" aria-label="Section principale">
    <div class="hero-bg" aria-hidden="true">
      <Image src="/tactical_terrain.webp" alt="Terrain tactique ASAP Airsoft Nay" width={1920} height={1080} class="hero-img" loading="eager" fetchpriority="high" />
      <div class="hero-overlay"></div>
    </div>

    <div class="container hero-content">
      <div class="hero-grid">
        <div class="hero-left">
          <div class="hero-badge-wrap">
            <span class="status-dot status-dot--on"></span>
            <span class="font-mono text-brand hero-tagline">// NAY (64) · BEARN AIRSOFT HQ</span>
          </div>

          <h1 class="hero-title">
            <span class="title-gradient">ASAP</span><br />
            <span class="hero-sub">AIRSOFT</span>
          </h1>

          <p class="hero-desc">
            Association Sportive Airsoft Pyrénéenne basée à <strong>Nay (près de Pau)</strong>.
            Opérations <strong>Milsim immersives</strong>, parties dominicales et événements scénarisés réalistes.
          </p>

          <div class="hero-actions">
            <a href="/nosparties" class="btn btn-filled btn-lg">Voir l'agenda →</a>
            <a href="https://discord.gg/uXB4TcP7Yy" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
              Rejoindre Discord →
            </a>
          </div>
        </div>

        <div class="hero-right">
          <div class="tactical-hud glass glass-shine">
            <div class="hud-header">
              <span class="hud-title font-mono">// TACTICAL_STATUS</span>
              <span class="status-dot status-dot--on"></span>
            </div>

            <div class="hud-body">
              <div class="hud-item">
                <span class="hud-label">SIÈGE SOCIAL</span>
                <span class="hud-val">Nay (64800) · Béarn</span>
              </div>
              <div class="hud-item">
                <span class="hud-label">TERRAIN OFFICIEL</span>
                <span class="hud-val">Parc de Caubous (50 HA)</span>
              </div>
              <div class="hud-item">
                <span class="hud-label">DISCIPLINES</span>
                <span class="hud-val">Milsim & Dominicales</span>
              </div>
              <div class="hud-item">
                <span class="hud-label">ACCÈS MEMBRES</span>
                <span class="hud-val text-brand">Briefings & Forum Privé</span>
              </div>
            </div>

            <div class="hud-footer">
              <a href="/connexion" class="btn btn-gold btn-sm w-full">
                Espace Adhérents →
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Ticker Bar -->
      <div class="hero-ticker glass glass-shine mt-5">
        <div class="ticker-item">
          <span class="ticker-num">50 HA</span>
          <span class="ticker-text">Terrain boisé naturel</span>
        </div>
        <div class="ticker-item">
          <span class="ticker-num">100%</span>
          <span class="ticker-text">Esprit Fair-Play</span>
        </div>
        <div class="ticker-item">
          <span class="ticker-num">MILSIM</span>
          <span class="ticker-text">Opérations scénarisées</span>
        </div>
        <div class="ticker-item">
          <span class="ticker-num">NAY 64</span>
          <span class="ticker-text">Pyrénées-Atlantiques</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ FLUX D'INSCRIPTION EN DIRECT ═══════════════ -->
  <section class="container mt-6 reveal scroll-reveal">
    <LiveRegistrationsWidget />
  </section>

  <!-- ═══════════════ AGENDA APERÇU ═══════════════ -->
  <section class="section container" aria-labelledby="agenda-title">
    <div class="section-header reveal">
      <span class="section-label">Agenda</span>
      <h2 id="agenda-title">Prochains <span class="title-gradient">Événements</span></h2>
      <div class="status ml-auto">
        <span class="status-dot status-dot--on"></span>
        <span>Connexion API Google Calendar active</span>
      </div>
    </div>
    <CalendarWidget />
    <div class="agenda-cta text-center reveal">
      <a href="https://discord.gg/uXB4TcP7Yy" target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-lg">
        S'inscrire via Discord
      </a>
    </div>
  </section>

  <!-- ═══════════════ STATS ═══════════════ -->
  <section class="section" aria-labelledby="stats-title">
    <div class="container">
      <div class="stats-wrap glass glass-shine reveal">
        <div class="stats-aurora" aria-hidden="true"></div>
        <span class="section-label text-center" style="width:100%;justify-content:center">ASAP en chiffres</span>
        <h2 id="stats-title" class="text-center" style="margin-bottom:var(--sp-8)">Rejoignez <span class="title-gradient">l'Escouade</span></h2>

        <div class="stats-grid">
          <div class="stat-item">
            <span class="stat-number" data-target="12">12+</span>
            <span class="stat-label">Membres actifs</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">2023</span>
            <span class="stat-label">Année de création</span>
          </div>
          <div class="stat-item">
            <span class="stat-number" data-target="12">12</span>
            <span class="stat-label">Opérations / an</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">100%</span>
            <span class="stat-label">Fair-play</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════ PARTENAIRE ═══════════════ -->
  <section class="section container" aria-labelledby="partner-title">
    <div class="partner-banner glass glass-shine glass--gold reveal">
      <div class="partner-content">
        <span class="section-label">Partenaire Officiel</span>
        <h2 id="partner-title" class="text-gold">Family Airsoft</h2>
        <p>Profitez de conseils d'experts et d'équipements de qualité auprès de notre boutique partenaire dédiée aux airsofteurs.</p>
      </div>
      <a href="https://family-airsoft.fr/" target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-lg flex-shrink-0">
        Visiter la boutique ↗
      </a>
    </div>
  </section>

  <!-- ═══════════════ JOIN CTA FINAL ═══════════════ -->
  <section class="section container" aria-label="Rejoindre l'association">
    <div class="join-cta glass glass-shine reveal text-center">
      <span class="section-label" style="justify-content:center">Prêt à rejoindre l'escouade ?</span>
      <h2>Devenez <span class="title-gradient">Adhérent ASAP</span></h2>
      <p class="mt-3" style="max-width:600px;margin-inline:auto">
        Rejoignez notre communauté sur Discord pour vous inscrire aux événements,
        accéder aux briefings et intégrer l'une de nos escouades.
      </p>
      <div class="join-actions mt-4">
        <a href="https://discord.gg/uXB4TcP7Yy" target="_blank" rel="noopener noreferrer" class="btn btn-filled btn-lg">
          Rejoindre sur Discord
        </a>
        <a href="/connexion" class="btn btn-primary btn-lg">
          Déjà membre ? Connexion
        </a>
      </div>
    </div>
  </section>

</Layout>

<script>
  // Count-up animé pour les stats (data-target déjà présents dans le HTML)
  const countEls = document.querySelectorAll<HTMLElement>('.stat-number[data-target]');

  function animateCount(el: HTMLElement) {
    const target = parseInt(el.getAttribute('data-target') || '0');
    if (isNaN(target)) return;
    const duration = 1800;
    const start = performance.now();
    const suffix = el.textContent?.includes('+') ? '+' : '';

    const update = (now: number) => {
      const elapsed = now - start;
      const progress = Math.min(elapsed / duration, 1);
      // Ease-out cubic
      const eased = 1 - Math.pow(1 - progress, 3);
      el.textContent = Math.round(eased * target) + suffix;
      if (progress < 1) requestAnimationFrame(update);
    };
    requestAnimationFrame(update);
  }

  if ('IntersectionObserver' in window && countEls.length > 0) {
    const countObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCount(entry.target as HTMLElement);
          countObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    countEls.forEach(el => countObserver.observe(el));
  }
</script>

<style>
  .section {
    padding-block: var(--section-y);
  }

  .section-header {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin-bottom: var(--sp-8);
  }

  .mt-3 { margin-top: var(--sp-4); }
  .mt-4 { margin-top: var(--sp-6); }
  .pt-3 { padding-top: var(--sp-4); }
  .ml-auto { margin-left: auto; }
  .flex-shrink-0 { flex-shrink: 0; }

  /* ── HERO ─────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: brightness(0.35) saturate(0.7);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(4,6,10,0.2) 0%, rgba(4,6,10,0.75) 55%, var(--bg-void) 100%),
      radial-gradient(ellipse 80% 90% at 20% 50%, rgba(0,212,170,0.10) 0%, transparent 55%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    padding-block: var(--sp-16) var(--sp-12);
    width: 100%;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: var(--sp-12);
    align-items: center;
  }

  @media (max-width: 992px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-8);
    }
  }

  .hero-badge-wrap {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-2) var(--sp-4);
    background: rgba(0, 212, 170, 0.08);
    border: 1px solid rgba(0, 212, 170, 0.2);
    border-radius: var(--r-full);
    margin-bottom: var(--sp-4);
  }

  .hero-tagline {
    font-size: var(--fs-xs);
    letter-spacing: 2px;
  }

  .hero-title {
    font-size: var(--fs-hero);
    font-weight: 900;
    line-height: 0.95;
    margin-block: var(--sp-3);
    letter-spacing: -1px;
  }

  .hero-sub {
    font-family: var(--font-sub);
    font-size: clamp(1.4rem, 1rem + 3vw, 2.8rem);
    color: var(--text-muted);
    font-weight: 600;
    letter-spacing: 8px;
    display: block;
    margin-top: var(--sp-2);
  }

  .hero-desc {
    font-size: var(--fs-lg);
    color: var(--text-main);
    line-height: 1.7;
    max-width: 580px;
    margin-bottom: var(--sp-6);
  }

  .hero-actions {
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  /* Tactical HUD box */
  .tactical-hud {
    padding: var(--card-pad);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    border-color: rgba(0, 212, 170, 0.3);
  }

  .hud-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid rgba(0, 212, 170, 0.15);
  }

  .hud-title {
    font-size: var(--fs-xs);
    color: var(--brand);
    letter-spacing: 2px;
  }

  .hud-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .hud-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hud-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .hud-val {
    font-weight: 600;
    color: var(--text-bright);
    font-size: var(--fs-sm);
  }

  .hud-footer {
    padding-top: var(--sp-2);
  }

  /* Hero Ticker Bar */
  .hero-ticker {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-4);
    padding: var(--sp-5) var(--sp-6);
    border-radius: var(--r-md);
  }

  @media (max-width: 768px) {
    .hero-ticker {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .ticker-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ticker-num {
    font-family: var(--font-title);
    font-size: var(--fs-lg);
    font-weight: 900;
    color: var(--brand);
  }

  .ticker-text {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .hero-status {
    display: flex;
    gap: var(--sp-6);
    flex-wrap: wrap;
  }

  /* Scroll indicator */
  .hero-scroll {
    position: absolute;
    bottom: var(--sp-8);
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .scroll-line {
    display: block;
    width: 1px;
    height: 60px;
    background: linear-gradient(180deg, var(--brand), transparent);
    animation: float 2s ease-in-out infinite;
  }

  /* ── ABOUT ──────────────────────────────────────────── */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-16);
    align-items: center;
  }

  @media (max-width: 768px) {
    .about-grid { grid-template-columns: 1fr; gap: var(--sp-8); }
  }

  .about-tags {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  .about-visual {
    position: relative;
  }

  .visual-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3/4;
    max-height: 520px;
  }

  .visual-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.6s ease;
  }

  .visual-frame:hover img {
    transform: scale(1.04);
  }

  .visual-badge {
    position: absolute;
    bottom: var(--sp-5);
    left: var(--sp-5);
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-sm);
    backdrop-filter: blur(10px);
  }

  /* ── BENTO GRID ─────────────────────────────────────── */
  .bento-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto auto;
    gap: var(--sp-4);
  }

  .bento-main { grid-row: 1 / 3; }

  .bento-sm {}

  @media (max-width: 768px) {
    .bento-grid {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    .bento-main { grid-row: 1; }
  }

  /* ── STATS ──────────────────────────────────────────── */
  .stats-wrap {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 4vw, 4rem);
    text-align: center;
  }

  .stats-aurora {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 80% at 20% 50%, rgba(0,212,170,0.06) 0%, transparent 60%),
      radial-gradient(ellipse 50% 60% at 80% 30%, rgba(201,168,76,0.05) 0%, transparent 55%);
    pointer-events: none;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-8);
    position: relative;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-3);
  }

  .stat-number {
    font-family: var(--font-title);
    font-size: clamp(2rem, 1.5rem + 3vw, 3.5rem);
    font-weight: 900;
    background: linear-gradient(135deg, var(--brand) 0%, var(--gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1;
  }

  .stat-label {
    font-family: var(--font-sub);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  /* ── AGENDA CTA ─────────────────────────────────────── */
  .agenda-cta { margin-top: var(--sp-10); }

  /* ── PARTENAIRE ─────────────────────────────────────── */
  .partner-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-8);
    padding: var(--sp-10);
  }

  @media (max-width: 640px) {
    .partner-banner { flex-direction: column; text-align: center; }
  }

  .partner-content { flex: 1; }

  /* ── JOIN CTA ───────────────────────────────────────── */
  .join-cta {
    padding: clamp(2.5rem, 5vw, 5rem);
  }

  .join-actions {
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
