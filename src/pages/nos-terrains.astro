---
import Layout from '../layouts/Layout.astro';
import CaubousMap from '../components/CaubousMap.astro';
import ReglementModal from '../components/ReglementModal.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Layout
  title="Terrain Officiel : Parc de Caubous – ASAP Airsoft"
  description="Découvrez le terrain officiel de l'ASAP au Parc de Caubous (Béarn 64). 50 hectares de forêt naturelle, bunkers, tranchées et règlement de sécurité."
  image="/tactical_terrain.webp"
>
  <!-- HEADER PAGE -->
  <div class="page-header">
    <div class="terrain-hero-img-wrap">
      <img src="/tactical_terrain.webp" alt="Terrain Parc de Caubous ASAP Airsoft" width="1920" height="600" loading="eager" />
      <div class="terrain-hero-fade"></div>
    </div>
    <div class="container terrain-header-content">
      <Breadcrumb items={[{ label: 'Accueil', href: '/' }, { label: 'Nos Terrains' }]} />
      <span class="section-label">Zone opérationnelle · Béarn</span>
      <h1 class="title-gradient">Terrain du Parc de Caubous</h1>
      <p class="page-desc">50 Hectares de forêt naturelle aménagée — Le terrain tactique de l'ASAP Airsoft.</p>
    </div>
  </div>

  <div class="container page-body">

    <!-- Terrain Principal -->
    <section class="terrain-section reveal" aria-labelledby="terrain-main-title">
      <div class="terrain-grid">
        <div class="terrain-info-card glass glass-shine">
          <span class="section-label">Secteur Nay – Pau</span>
          <h2 id="terrain-main-title">Le Terrain<br /><span class="title-gradient">Principal</span></h2>
          <p class="mt-3">
            Un espace forestier exceptionnel de <strong>50 hectares</strong> en bordure du Béarn,
            configuré spécialement pour des missions d'infiltration, des combats d'escouades
            et des opérations Milsim longue durée.
          </p>

          <div class="feature-list mt-4">
            <div class="feature-item">
              <span class="badge badge-brand">// FORET</span>
              <div>
                <strong>Forêt Dense</strong>
                <p>Végétation naturelle dense — camouflage naturel, immersion garantie.</p>
              </div>
            </div>
            <div class="feature-item">
              <span class="badge badge-gold">// ZONE</span>
              <div>
                <strong>Surface</strong>
                <p>50 Hectares naturels délimités avec balisage militaire visible.</p>
              </div>
            </div>
            <div class="feature-item">
              <span class="badge badge-ember">// SEC</span>
              <div>
                <strong>Sécurité</strong>
                <p>Limites de zone clairement identifiées. Zone de sécurité respectée en permanence.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Réglement -->
        <div class="rules-card glass glass-shine reveal reveal-delay-2">
          <div class="rules-header">
            <span class="badge badge-ember">MIL-REG</span>
            <h3 class="text-bright" style="font-size:var(--fs-xl)">Règlement Sécurité</h3>
          </div>

          <ul class="rules-list">
            <li class="rule-item">
              <span class="rule-dot" style="background:var(--brand)"></span>
              <div>
                <strong>Protection oculaire obligatoire</strong>
                <p>Lunettes homologuées EN166B en permanence sur le terrain, sans exception.</p>
              </div>
            </li>
            <li class="rule-item">
              <span class="rule-dot" style="background:var(--gold)"></span>
              <div>
                <strong>Passage Chrony systématique</strong>
                <p>Toutes les répliques sont vérifiées avant chaque session de jeu.</p>
              </div>
            </li>
            <li class="rule-item">
              <span class="rule-dot" style="background:var(--brand)"></span>
              <div>
                <strong>Fair-play absolu</strong>
                <p>L'annonce honnête des touches est la règle fondamentale de l'association.</p>
              </div>
            </li>
            <li class="rule-item">
              <span class="rule-dot" style="background:var(--ember)"></span>
              <div>
                <strong>Distance de tir minimale</strong>
                <p>Règles strictes adaptées à la puissance de chaque réplique (FPS).</p>
              </div>
            </li>
            <li class="rule-item">
              <span class="rule-dot" style="background:var(--gold)"></span>
              <div>
                <strong>Billes biodégradables</strong>
                <p>Obligatoires pour la préservation de l'environnement du terrain.</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Équipements & Confort Safezone -->
    <section class="terrain-stats glass glass-shine reveal" aria-label="Équipements et Confort">
      <div class="section-label text-center" style="width:100%;justify-content:center;margin-bottom:var(--sp-4)">// CONFORT SAFE ZONE</div>
      <div class="stats-row">
        <div class="t-stat">
          <span class="badge badge-brand mb-2">SAFE</span>
          <span class="t-stat-label">Barbecue</span>
        </div>
        <div class="t-stat">
          <span class="badge badge-brand mb-2">SAFE</span>
          <span class="t-stat-label">Toilettes</span>
        </div>
        <div class="t-stat">
          <span class="badge badge-brand mb-2">SAFE</span>
          <span class="t-stat-label">Micro-ondes</span>
        </div>
        <div class="t-stat">
          <span class="badge badge-brand mb-2">SAFE</span>
          <span class="t-stat-label">Frigo</span>
        </div>
        <div class="t-stat">
          <span class="badge badge-brand mb-2">SAFE</span>
          <span class="t-stat-label">Machine à café</span>
        </div>
      </div>
    </section>

    <!-- Carte du Parc de Caubous -->
    <CaubousMap />

    <!-- Règlement Intérieur & Charte de Sécurité Imprimable -->
    <ReglementModal />

    <!-- CTA -->
    <div class="page-cta text-center reveal">
      <p class="text-muted mb-4">Envie de découvrir le terrain en vrai ?</p>
      <div style="display:flex;gap:var(--sp-4);justify-content:center;flex-wrap:wrap">
        <a href="/nosparties" class="btn btn-filled btn-lg">Voir les prochaines parties</a>
        <a href="https://discord.gg/uXB4TcP7Yy" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Rejoindre Discord</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .page-header {
    position: relative;
    height: clamp(300px, 40vh, 500px);
    overflow: hidden;
    margin-bottom: var(--sp-16);
  }

  .terrain-hero-img-wrap {
    position: absolute;
    inset: 0;
  }

  .terrain-hero-img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.4) saturate(0.7);
  }

  .terrain-hero-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(4,6,10,0.2) 0%, var(--bg-void) 100%);
  }

  .terrain-header-content {
    position: absolute;
    bottom: var(--sp-10);
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
  }

  h1 { font-size: var(--fs-3xl); }
  .page-desc { font-size: var(--fs-lg); max-width: 560px; margin-top: var(--sp-3); color: var(--text-main); }
  .mt-3 { margin-top: var(--sp-4); }
  .mt-4 { margin-top: var(--sp-6); }
  .mb-4 { margin-bottom: var(--sp-6); }

  .page-body { padding-bottom: var(--sp-24); }

  /* Terrain grid */
  .terrain-section { margin-bottom: var(--sp-12); }

  .terrain-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--sp-6);
    align-items: start;
  }

  @media (max-width: 768px) {
    .terrain-grid { grid-template-columns: 1fr; }
  }

  .terrain-info-card,
  .rules-card {
    padding: var(--card-pad);
  }

  /* Features */
  .feature-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .feature-item {
    display: flex;
    gap: var(--sp-4);
    align-items: flex-start;
  }

  .feature-icon {
    font-size: 1.4rem;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .feature-item strong {
    display: block;
    font-family: var(--font-sub);
    font-size: var(--fs-md);
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--text-bright);
    margin-bottom: var(--sp-1);
  }

  .feature-item p {
    font-size: var(--fs-sm);
    margin: 0;
  }

  /* Rules */
  .rules-header {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--glass-border);
  }

  .rules-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .rule-item {
    display: flex;
    gap: var(--sp-4);
    align-items: flex-start;
  }

  .rule-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 6px;
    box-shadow: 0 0 8px currentColor;
  }

  .rule-item strong {
    display: block;
    color: var(--text-bright);
    font-family: var(--font-sub);
    font-size: var(--fs-md);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 2px;
  }

  .rule-item p { font-size: var(--fs-sm); margin: 0; }

  /* Terrain stats */
  .terrain-stats {
    padding: var(--sp-10);
    margin-bottom: var(--sp-12);
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: var(--sp-6);
    text-align: center;
  }

  @media (max-width: 640px) {
    .stats-row { grid-template-columns: repeat(2, 1fr); }
  }

  .t-stat { display: flex; flex-direction: column; align-items: center; gap: var(--sp-2); }

  .t-stat-num {
    font-family: var(--font-title);
    font-size: clamp(2.2rem, 2rem + 2vw, 3.2rem);
    font-weight: 900;
    line-height: 1;
  }

  .t-stat-label {
    font-family: var(--font-sub);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
  }

  .page-cta { padding-block: var(--sp-8); }
</style>
