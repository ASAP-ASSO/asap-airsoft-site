---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Layout
  title="Le Milsim – Simulation Militaire ASAP"
  description="Découvrez la doctrine Milsim chez ASAP Airsoft à Nay (64). Opérations immersives, chaîne de commandement, système médical scénarisé et autonomie terrain."
  image="/milsim_player.webp"
>
  <!-- HERO MILSIM -->
  <div class="milsim-hero">
    <div class="milsim-hero-bg">
      <img src="/milsim_player.webp" alt="Opérateur Milsim ASAP" width="1920" height="900" loading="eager" />
      <div class="milsim-hero-overlay"></div>
    </div>
    <div class="container milsim-hero-content">
      <Breadcrumb items={[{ label: 'Accueil', href: '/' }, { label: 'Milsim' }]} />
      <span class="badge badge-ember mb-3" style="display:inline-flex">CLASSE : MILSIM</span>
      <h1>Simulation<br /><span class="title-gradient">Militaire</span></h1>
      <p class="hero-desc">Immersion totale, tactique d'escouade et dépassement de soi dans les forêts du Béarn.</p>
      <div class="status mt-4">
        <span class="status-dot status-dot--on"></span>
        <span>Programme MILSIM ASAP · OPÉRATIONS PLANIFIÉES</span>
      </div>
    </div>
  </div>

  <div class="container page-body">

    <!-- Doctrine Milsim -->
    <section class="doctrine-section reveal" aria-labelledby="doctrine-title">
      <div class="doctrine-grid">

        <div class="glass glass-shine doctrine-main">
          <div class="p-card">
            <span class="section-label">Doctrine ASAP</span>
            <h2 id="doctrine-title" class="text-bright">La Doctrine<br /><span class="title-gradient">Milsim</span></h2>
            <p class="mt-3">
              Le <strong>Milsim (Military Simulation)</strong> représente le sommet de l'immersion dans l'airsoft.
              Contrairement aux parties dominicales courtes, le Milsim met l'accent sur le jeu de rôle militaire,
              l'obéissance à la chaîne de commandement, l'accomplissement d'objectifs complexes et la gestion des ressources.
            </p>

            <h3 class="pillar-title mt-4">Les 4 Piliers du Jeu Milsim</h3>

            <div class="pillars-grid">
              {[
                {
                  num: '01',
                  title: 'Chaîne de Commandement',
                  desc: 'Chaque joueur est affecté à un groupe sous les ordres d\'un chef de groupe (SL). L\'exécution des ordres assure le succès de la mission.',
                },
                {
                  num: '02',
                  title: 'Gestion des Munitions',
                  desc: 'Seuls les chargeurs low-cap / mid-cap (30–120 billes) sont acceptés. Pas de hi-cap — gestion réaliste des munitions obligatoire.',
                },
                {
                  num: '03',
                  title: 'Système Médical',
                  desc: 'Lorsqu\'un joueur est touché, il doit appeler un médecin d\'équipe et appliquer un bandage d\'entraînement avant de retourner au combat.',
                },
                {
                  num: '04',
                  title: 'Durée & Autonomie',
                  desc: 'Les opérations durent 12h, 24h ou plus. Les joueurs gèrent leur eau, leurs rations et leur fatigue en complète autonomie terrain.',
                },
              ].map(p => (
                <div class="pillar-card glass">
                  <div class="pillar-num font-mono text-brand">{p.num}</div>
                  <h4 class="text-bright">{p.title}</h4>
                  <p>{p.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar Forum Milsim -->
        <aside class="sidebar">
          <div class="glass glass-shine sidebar-box reveal reveal-delay-2">
            <div class="sidebar-header">
              <span class="badge badge-brand">ESPACE PRIVÉ</span>
              <h3 class="text-bright mt-2">Opérateurs Milsim</h3>
            </div>

            <p class="mt-3">
              L'ASAP dispose d'un groupe dédié d'opérateurs Milsim qui planifient des opérations secrètes
              et coordonnent leurs briefings en privé via notre forum.
            </p>

            <div class="forum-teaser glass mt-4">
              <div class="forum-teaser-icon" aria-hidden="true">💬</div>
              <h4 class="text-bright">Forum Milsim Privé</h4>
              <p>Accès réservé aux membres certifiés. Briefings opérationnels, débats tactiques et planification en équipe.</p>
              <a href="/forum" class="btn btn-primary w-full mt-3">Accéder au Forum</a>
            </div>

            <div class="milsim-tags mt-4">
              <p class="text-muted mb-2" style="font-size:var(--fs-xs);text-transform:uppercase;letter-spacing:1px">Certifications requises</p>
              <div style="display:flex;gap:var(--sp-2);flex-wrap:wrap">
                <span class="badge badge-brand">Milsim</span>
                <span class="badge badge-gold">Expérience terrain</span>
              </div>
            </div>

            <p class="note-text mt-4">
              La certification Milsim est attribuée par l'administration après validation de votre profil.
              Contactez-nous sur Discord.
            </p>
          </div>

          <!-- Stats Milsim -->
          <div class="glass glass-shine sidebar-box reveal reveal-delay-3">
            <span class="section-label">Données de terrain</span>
            <div class="milsim-stats">
              <div class="m-stat">
                <span class="m-num title-gradient">12h+</span>
                <span class="m-label">Durée op. standard</span>
              </div>
              <div class="m-stat">
                <span class="m-num title-gradient">30</span>
                <span class="m-label">Billes max mid-cap</span>
              </div>
              <div class="m-stat">
                <span class="m-num title-gradient">4+</span>
                <span class="m-label">Joueurs par escouade</span>
              </div>
            </div>
          </div>
        </aside>

      </div>
    </section>

    <!-- CTA rejoindre -->
    <div class="glass glass-shine text-center cta-bottom reveal">
      <span class="section-label" style="justify-content:center">Prêt pour l'immersion ?</span>
      <h2 class="text-bright mt-2">Rejoignez le Programme <span class="title-gradient">Milsim ASAP</span></h2>
      <p class="mt-3" style="max-width:560px;margin-inline:auto">
        Commencez par des parties dominicales, montez en compétences et obtenez votre certification Milsim pour accéder aux opérations privées.
      </p>
      <div style="display:flex;gap:var(--sp-4);justify-content:center;flex-wrap:wrap;margin-top:var(--sp-6)">
        <a href="/nosparties" class="btn btn-filled btn-lg">Voir l'agenda</a>
        <a href="https://discord.gg/uXB4TcP7Yy" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Rejoindre Discord</a>
      </div>
    </div>

  </div>
</Layout>

<style>
  .mb-3 { margin-bottom: var(--sp-4); }
  .mt-2 { margin-top: var(--sp-3); }
  .mt-3 { margin-top: var(--sp-4); }
  .mt-4 { margin-top: var(--sp-6); }
  .mb-2 { margin-bottom: var(--sp-3); }
  .w-full { width: 100%; }

  /* Hero */
  .milsim-hero {
    position: relative;
    height: clamp(380px, 55vh, 600px);
    overflow: hidden;
    margin-bottom: var(--sp-16);
  }

  .milsim-hero-bg {
    position: absolute;
    inset: 0;
  }

  .milsim-hero-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: brightness(0.35) saturate(0.7);
  }

  .milsim-hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(4,6,10,0.4) 0%, var(--bg-void) 100%),
      radial-gradient(ellipse 60% 80% at 70% 50%, rgba(0,212,170,0.06) 0%, transparent 60%);
  }

  .milsim-hero-content {
    position: absolute;
    bottom: var(--sp-12);
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
  }

  h1 { font-size: var(--fs-3xl); }
  .hero-desc { font-size: var(--fs-lg); max-width: 580px; margin-top: var(--sp-4); color: var(--text-main); }

  /* Layout */
  .page-body { padding-bottom: var(--sp-24); }

  .doctrine-section { margin-bottom: var(--sp-12); }

  .doctrine-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--sp-6);
    align-items: start;
  }

  @media (max-width: 900px) {
    .doctrine-grid { grid-template-columns: 1fr; }
  }

  .p-card { padding: var(--card-pad); }

  /* Pillars */
  .pillar-title {
    font-size: var(--fs-lg);
    color: var(--text-bright);
    letter-spacing: 1px;
    padding-top: var(--sp-6);
    border-top: 1px solid var(--glass-border);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-4);
    margin-top: var(--sp-4);
  }

  @media (max-width: 640px) {
    .pillars-grid { grid-template-columns: 1fr; }
  }

  .pillar-card {
    padding: var(--sp-5);
    border-radius: var(--r-md);
  }

  .pillar-num {
    font-size: var(--fs-xs);
    letter-spacing: 2px;
    margin-bottom: var(--sp-2);
  }

  .pillar-card h4 {
    font-size: var(--fs-md);
    letter-spacing: 1px;
    margin-bottom: var(--sp-2);
  }

  .pillar-card p { font-size: var(--fs-sm); margin: 0; }

  /* Sidebar */
  .sidebar { display: flex; flex-direction: column; gap: var(--sp-5); }
  .sidebar-box { padding: var(--card-pad); }

  .sidebar-header { padding-bottom: var(--sp-4); border-bottom: 1px solid var(--glass-border); }

  /* Forum teaser */
  .forum-teaser {
    border-radius: var(--r-md);
    padding: var(--sp-5);
    text-align: center;
  }

  .forum-teaser-icon { font-size: 2rem; margin-bottom: var(--sp-2); }
  .forum-teaser h4 { font-size: var(--fs-lg); margin-bottom: var(--sp-2); }
  .forum-teaser p { font-size: var(--fs-sm); }

  .note-text { font-size: var(--fs-xs); color: var(--text-muted); font-style: italic; }

  /* Milsim stats */
  .milsim-stats {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    margin-top: var(--sp-4);
  }

  .m-stat { display: flex; align-items: center; gap: var(--sp-4); }

  .m-num {
    font-family: var(--font-title);
    font-size: var(--fs-2xl);
    font-weight: 900;
    min-width: 90px;
  }

  .m-label {
    font-family: var(--font-sub);
    font-size: var(--fs-sm);
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
  }

  /* CTA Bottom */
  .cta-bottom { padding: clamp(2.5rem, 5vw, 5rem); }
</style>
