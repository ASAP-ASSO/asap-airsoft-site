---
interface Props {
  title?: string;
  image?: string;
  badge?: string;
  badgeVariant?: 'primary' | 'accent' | 'info' | 'success';
  class?: string;
  href?: string;
}

const {
  title,
  image,
  badge,
  badgeVariant = 'primary',
  class: className = '',
  href,
} = Astro.props;

const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={['hud-card hud-panel', className, { 'hud-card--linked': !!href }]}
  href={href}
  {...href ? { 'aria-label': title } : {}}
>
  {image && (
    <div class="card-image">
      <img
        src={image}
        alt={title || ''}
        loading="lazy"
        decoding="async"
      />
      <div class="card-image-overlay" aria-hidden="true"></div>
      {badge && (
        <span class={`card-img-badge hud-badge hud-badge--${badgeVariant}`}>
          {badge}
        </span>
      )}
    </div>
  )}

  <div class="card-body">
    {title && (
      <h3 class="card-title">
        <span class="card-title-bar" aria-hidden="true"></span>
        {title}
      </h3>
    )}
    <div class="card-content">
      <slot />
    </div>
  </div>

  <!-- Indicateur coin supérieur droit (extra décoration HUD) -->
  <span class="card-corner-mark" aria-hidden="true"></span>
</Tag>

<style>
  .hud-card {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-card, var(--color-bg-card));
    overflow: hidden;
    transition: var(--transition-base, all 0.3s ease);
    height: 100%;
    container-type: inline-size;
  }

  @container (max-width: 320px) {
    .card-image {
      height: 150px;
    }
    .card-body {
      padding: var(--sp-3);
    }
  }

  /* Version lien cliquable */
  .hud-card--linked {
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }

  .hud-card:hover,
  .hud-card--linked:hover {
    border-color: var(--color-border-hover);
    box-shadow: var(--glow-sm), var(--shadow-panel);
    transform: translateY(-4px);
  }

  /* Agrandir les coins au hover */
  .hud-card:hover::before,
  .hud-card:hover::after {
    width: 16px;
    height: 16px;
  }

  /* ── Image ─────────────────────────────────────────────── */
  .card-image {
    position: relative;
    width: 100%;
    height: 210px;
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .hud-card:hover .card-image img {
    transform: scale(1.06);
  }

  .card-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 40%,
      rgba(10, 12, 9, 0.7) 100%
    );
    pointer-events: none;
  }

  .card-img-badge {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
  }

  /* ── Corps ─────────────────────────────────────────────── */
  .card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--card-padding);
    gap: var(--space-4);
  }

  /* ── Titre ─────────────────────────────────────────────── */
  .card-title {
    font-size: var(--fs-lg);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    letter-spacing: var(--ls-normal);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .card-title-bar {
    display: block;
    width: 2px;
    height: 1.1em;
    background: var(--color-primary);
    flex-shrink: 0;
    transition: var(--transition-base);
    box-shadow: var(--glow-sm);
  }

  .hud-card:hover .card-title-bar {
    box-shadow: var(--glow-md);
  }

  /* ── Contenu slot ─────────────────────────────────────── */
  .card-content {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .card-content :global(p) {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
    line-height: var(--lh-loose);
  }

  /* ── Décoration coin sup. droit ─────────────────────── */
  .card-corner-mark {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 6px;
    height: 6px;
    border-top: 1px solid var(--color-primary);
    border-right: 1px solid var(--color-primary);
    opacity: 0;
    transition: var(--transition-base);
  }

  .hud-card:hover .card-corner-mark {
    opacity: 1;
  }
</style>
